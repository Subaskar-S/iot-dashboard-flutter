# Copy to key.properties and fill in, then keep key.properties out of git
# (android/.gitignore already excludes it, along with *.jks and *.keystore).
#
# Generate the upload keystore:
#
#   keytool -genkey -v -keystore ~/iot-dashboard-upload.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# BACK THE .jks FILE UP SOMEWHERE SAFE. If you lose it you can never publish an
# update to the app under the same listing — Google cannot recover it for you.

storeFile=/Users/you/iot-dashboard-upload.jks
storePassword=
keyAlias=upload
keyPassword=
