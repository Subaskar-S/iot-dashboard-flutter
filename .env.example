# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# Domain that points at this server's public IP. Caddy issues the TLS
# certificate for it, so DNS must resolve before you start the stack.
DOMAIN=api.example.com

# Address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=you@example.com

# Signs every JWT. Anyone who knows it can forge admin tokens.
# Generate with: openssl rand -base64 48
IOT_JWT_SECRET=

# Bootstrap admin account, re-seeded on every restart (users are held in
# memory, not in SQLite — see src/security/authentication_service.hpp).
IOT_ADMIN_USER=admin
IOT_ADMIN_PASSWORD=
